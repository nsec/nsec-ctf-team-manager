# PostgreSQL connection settings. Use "localhost" when running the backend
# directly; use "postgres" when running it with Docker Compose.
TEAM_MANAGER_DB_HOST=postgres
TEAM_MANAGER_DB_PORT=5432
TEAM_MANAGER_DB_NAME=team_manager
TEAM_MANAGER_DB_USER=team_manager
TEAM_MANAGER_DB_PASSWORD=CHANGEME
# Rotating application log file (relative to the backend working directory).
TEAM_MANAGER_LOG_FILE=team_manager.log

# Team size and name-length limits.
TEAM_MANAGER_MAX_MEMBERS=8
TEAM_MANAGER_MIN_NAME=1
TEAM_MANAGER_MAX_NAME=128

# Comma-separated origins allowed to call the API.
TEAM_MANAGER_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://[::1]:8080,https://team-manager.nsec.io

PRETIX_API_KEY=CHANGEME
PRETIX_URL=https://registrations.nsec.io/api/v1
PRETIX_CTF_NAME=northsec/2027