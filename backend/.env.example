# SQLite database path (relative to the backend working directory).
TEAM_MANAGER_DB=team_manager.db

# Team size and name-length limits.
TEAM_MANAGER_MAX_MEMBERS=8
TEAM_MANAGER_MIN_NAME=1
TEAM_MANAGER_MAX_NAME=128

# Comma-separated origins allowed to call the API.
TEAM_MANAGER_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://team-manager.nsec.io

